package {
    default_applicable_licenses: ["platform_sdk_license"],
}

license {
    name: "platform_sdk_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
}

android_app {
    name: "com.evervolv.platform-res",
    use_resource_processor: false,
    sdk_version: "core_platform",
    certificate: "platform",

    manifest: "services/res/AndroidManifest.xml",

    // Disable dexpreopt and verify_uses_libraries check as the app
    // contains no Java code to be dexpreopted.
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },

    // Soong special-cases org.lineageos.platform-res to install this alongside
    // the libraries at /system_ext/framework/com.evervolv.platform-res.apk.

    aaptflags: [
        "--private-symbols",
        "com.evervolv.platform.internal",

        // Framework doesn't need versioning since it IS the platform.
        "--no-auto-version",

        // Allow overlay to add resource
        "--auto-add-overlay",

        // Framework resources benefit tremendously from enabling sparse encoding, saving tens
        // of MBs in size and RAM use.
        "--enable-sparse-encoding",

        // Tell aapt to create "extending (non-application)" resource IDs,
        // since these resources will be used by many apps.
        "--allow-reserved-package-id",
        // Use id 0x3f (one less than app id).
        "--package-id",
        "63",
    ],

    resource_dirs: [
        "services/res/res",
    ],

    // Create package-export.apk, which other packages can use to get
    // PRODUCT-agnostic resource data like IDs and type definitions.
    export_package_resources: true,

    generate_product_characteristics_rro: true,
}

// The Platform Framework Library
// ============================================================

filegroup {
    name: "platform-sdk-core-sources",
    srcs: [
        "core/java/**/*.java",
        "core/java/**/I*.aidl",
    ],
}

filegroup {
    name: "platform-sdk-service-sources",
    srcs: [
        "services/java/**/*.java",
    ],
}

java_defaults {
    name: "com.evervolv.platform-defaults",
    srcs: [
        ":platform-sdk-core-sources",
        // For the generated R.java and Manifest.java
        ":com.evervolv.platform-res{.aapt.srcjar}",
    ],
    aidl: {
        local_include_dirs: ["core/java"],
    },
    static_libs: [
        "vendor.lineage.health-V2-java",
        "vendor.lineage.livedisplay-V2.0-java",
        "vendor.lineage.livedisplay-V2.1-java",
        "vendor.lineage.touch-V1.0-java",
    ],
}

java_library {
    name: "com.evervolv.platform",
    defaults: ["com.evervolv.platform-defaults"],
    installable: true,
    sdk_version: "core_platform",
    srcs: [":platform-sdk-service-sources"],
    libs: [
        "framework",
        "services",
    ],
    required: [
        "com.evervolv.platform-sysconfig.xml",
        "org.lineageos.globalactions.xml",
        "org.lineageos.hardware.xml",
        "org.lineageos.health.xml",
        "org.lineageos.livedisplay.xml",
    ],
    dxflags: [
        "--core-library",
        "--multi-dex",
    ],
}

// Full target for use by platform apps
// ============================================================

java_library {
    name: "com.evervolv.platform.internal",
    defaults: ["com.evervolv.platform-defaults"],
}
