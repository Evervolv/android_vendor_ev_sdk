android_library {
    name: "PartsPreference",
    min_sdk_version: "30",
    aidl: {
        local_include_dirs: ["src"],
    },
    srcs: [
        "src/**/*.java",
        "src/**/I*.aidl",
    ],
    static_libs: [
        "EVSettingsPreference",
    ],
}
